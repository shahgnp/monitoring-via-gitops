{
  "uid": "overview",
  "title": "Overview - metrics",
  "tags": ["tenant", "metrics"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-1h", "to": "now" },
  "description": "Pod health, resource usage and request rate for this namespace.",
  "templating": {
    "list": [
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "__PROM_UID__" },
        "definition": "label_values(kube_pod_info{namespace=\"__NAMESPACE__\"}, pod)",
        "query": { "query": "label_values(kube_pod_info{namespace=\"__NAMESPACE__\"}, pod)", "refId": "PrometheusVariableQueryEditor-VariableQuery", "qryType": 1 },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running pods",
      "datasource": { "type": "prometheus", "uid": "__PROM_UID__" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        { "refId": "A", "instant": true, "expr": "count(kube_pod_status_phase{namespace=\"__NAMESPACE__\", phase=\"Running\", pod=~\"$pod\"} == 1) or vector(0)" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Container restarts (last hour)",
      "datasource": { "type": "prometheus", "uid": "__PROM_UID__" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        { "refId": "A", "instant": true, "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"__NAMESPACE__\", pod=~\"$pod\"}[1h])) or vector(0)" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "HTTP requests/s",
      "datasource": { "type": "prometheus", "uid": "__PROM_UID__" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(nginx_http_requests_total{namespace=\"__NAMESPACE__\", pod=~\"$pod\"}[5m]))" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active connections",
      "datasource": { "type": "prometheus", "uid": "__PROM_UID__" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "sum(nginx_connections_active{namespace=\"__NAMESPACE__\", pod=~\"$pod\"})" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU usage (cores) by pod",
      "datasource": { "type": "prometheus", "uid": "__PROM_UID__" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}}", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"__NAMESPACE__\", pod=~\"$pod\", container!=\"\"}[5m]))" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory (working set) by pod",
      "datasource": { "type": "prometheus", "uid": "__PROM_UID__" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}}", "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"__NAMESPACE__\", pod=~\"$pod\", container!=\"\"})" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP requests/s by pod",
      "datasource": { "type": "prometheus", "uid": "__PROM_UID__" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}}", "expr": "sum by (pod) (rate(nginx_http_requests_total{namespace=\"__NAMESPACE__\", pod=~\"$pod\"}[5m]))" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Network traffic by pod",
      "datasource": { "type": "prometheus", "uid": "__PROM_UID__" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "Bps", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "rx {{pod}}", "expr": "sum by (pod) (rate(container_network_receive_bytes_total{namespace=\"__NAMESPACE__\", pod=~\"$pod\"}[5m]))" },
        { "refId": "B", "legendFormat": "tx {{pod}}", "expr": "sum by (pod) (rate(container_network_transmit_bytes_total{namespace=\"__NAMESPACE__\", pod=~\"$pod\"}[5m]))" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Container restarts by pod",
      "datasource": { "type": "prometheus", "uid": "__PROM_UID__" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "fieldConfig": { "defaults": { "decimals": 0, "min": 0, "custom": { "drawStyle": "bars" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}}", "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"__NAMESPACE__\", pod=~\"$pod\"}[$__rate_interval]))" }
      ]
    }
  ]
}
