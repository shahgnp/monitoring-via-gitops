{
  "uid": "tenant-overview",
  "title": "Tenant overview",
  "tags": ["tenant"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running pods",
      "datasource": { "type": "prometheus", "uid": "__PROM_UID__" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "count(kube_pod_status_phase{phase=\"Running\"} == 1)" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests per second",
      "datasource": { "type": "prometheus", "uid": "__PROM_UID__" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(nginx_http_requests_total[5m]))" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Scrape targets up",
      "datasource": { "type": "prometheus", "uid": "__PROM_UID__" },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "up", "legendFormat": "{{pod}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU (cores) by pod",
      "datasource": { "type": "prometheus", "uid": "__PROM_UID__" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{container!=\"\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memory by pod",
      "datasource": { "type": "prometheus", "uid": "__PROM_UID__" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{container!=\"\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Log lines per minute by pod",
      "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (count_over_time({namespace=~\".+\"}[1m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Logs",
      "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 19 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "expr": "{namespace=~\".+\"}" }
      ]
    }
  ]
}
