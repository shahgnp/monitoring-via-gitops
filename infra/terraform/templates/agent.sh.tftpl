#!/bin/bash
set -euxo pipefail
exec > >(tee /var/log/rke2-bootstrap.log) 2>&1
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y open-iscsi nfs-common curl jq
systemctl enable --now iscsid

# The external cloud provider matches nodes by their EC2 private DNS name.
IMDS_TOKEN=$(curl -sX PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
NODE_NAME=$(curl -s -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/hostname)

mkdir -p /etc/rancher/rke2
cat > /etc/rancher/rke2/config.yaml <<EOF
server: https://${nlb_dns}:9345
token: ${token}
node-name: $NODE_NAME
profile: cis
cloud-provider-name: external
kube-proxy-arg:
  - metrics-bind-address=0.0.0.0:10249
EOF

curl -sfL https://get.rke2.io | INSTALL_RKE2_VERSION="${rke2_version}" INSTALL_RKE2_TYPE="agent" sh -

# CIS kernel parameters must be applied before rke2 starts.
cp -f /usr/local/share/rke2/rke2-cis-sysctl.conf /etc/sysctl.d/60-rke2-cis.conf
systemctl restart systemd-sysctl

systemctl enable --now rke2-agent.service
